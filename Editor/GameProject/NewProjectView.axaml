<UserControl x:Class="LumenX.GameProject.NewProjectView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LumenX.GameProject"
             Height="450" Width="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ListBox Width="200" Height="250" Background="#d4cdc7"/>
            <Border Width="400" Height="250" Margin="5,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
            <TextBlock Text="Name" Width="50"/>
            <TextBox Width="550" Height="5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <TextBlock Text="Path" Width="50"/>
            <TextBox Width="500" Height="5"/>
            <Button Content="Browse" Width="45" Margin="5,0,0,0" FontSize="8"></Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
            <Button Content="Create" Width="96" Height="25" FontSize="10" IsDefault="True"/>
            <Button Content="Exit" Width="96" Height="25" FontSize="10" Margin="5,0,0,0"
            IsCancel="True" Click="Button_Click" x:Name="ExitButton"/>
        </StackPanel>
    </StackPanel>
</UserControl>