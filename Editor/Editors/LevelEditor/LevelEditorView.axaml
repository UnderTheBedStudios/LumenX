<UserControl x:Class="LumenX.Editors.LevelEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LumenX.Editors"
             Background="#00000000"
             d:DesignWidth="800"
             d:DesignHeight="450">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <local:EngineViewport Grid.Row="0" Focusable="true"/>
            <GridSplitter Grid.Row="1" Height="5"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Background="#AFAFAF"/>
        </Grid>
        <GridSplitter Grid.Column="1" Width="5"
        HorizontalAlignment="Left" VerticalAlignment="Stretch"
        Background="#AFAFAF"/>
        <Grid Grid.Column="1" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" Height="5"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Background="#AFAFAF"/>
            <local:ProjectLayoutView/>
            <Viewbox Stretch="Uniform" Grid.Row="1" VerticalAlignment="Top" Margin="10">
                <TabControl TabStripPlacement="Top">
                    <TabItem Header="Details">
                        
                    </TabItem>
                    <TabItem Header="World Settings">
                        <local:WorldSettingsView/>
                    </TabItem>
                </TabControl>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>