<UserControl x:Class="LumenX.Editors.ProjectLayoutView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LumenX.Editors"
             xmlns:proj="clr-namespace:LumenX.GameProject"
             mc:Ignorable="d"
             x:DataType="proj:Project"
             d:DesignWidth="800"
             d:DesignHeight="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Content="Add World" Width="96" Height="30"
        VerticalAlignment="Center" Focusable="False" Grid.Row="0"
        HorizontalAlignment="Left" Margin="20,0,0,0"
        Command="{Binding AddWorld}"/>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Worlds}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="proj:World">
                        <Grid>
                        <Expander IsExpanded="{Binding Active, Mode=OneWay}">
                            <Expander.Header>
                                    <TextBlock Grid.Column="0" Text="{Binding WorldName}" VerticalAlignment="Center"/>
                            </Expander.Header>
                        </Expander>
                        <Button Grid.Column="1" Content="Remove World" Margin="180, 0, 0, 0"
                                        Command="{Binding #Root.DataContext.RemoveWorld}"
                                        CommandParameter="{Binding}"
                                        x:CompileBindings="False"
                                        Focusable="False"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>